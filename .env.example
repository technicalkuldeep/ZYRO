# Google account identity for Arena only. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
MONGODB_URI=
MONGODB_DB_NAME=zyro
ZYRO_TAZ_TESTNET_MONGO_URI=
ADMIN_GOOGLE_EMAIL=web3kuldeep@gmail.com
ADMIN_GRANT_LIMIT=10000
# Opaque random session tokens are hashed in MongoDB; no SESSION_SECRET required.
# Copy to .env at the repository root. Empty DATABASE_URL enables legacy-market SQLite.
DATABASE_URL=
POSTGRES_PASSWORD=
# Dedicated integration database URL; tests do not fall back to a deployment database.
TEST_DATABASE_URL=
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
# apps/web reads API_URL from its own environment; default is this loopback URL.
API_URL=http://127.0.0.1:4000
# Optional read-only testnet/regtest node RPC. Never expose wallet RPC publicly.
ZCASH_RPC_URL=
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_NETWORK=testnet
# Optional independently verified genesis fingerprint; mandatory for regtest nodes reporting "test".
ZCASH_GENESIS_HASH=
# Alternative read-only public testnet connectivity, no wallet keys:
LIGHTWALLETD_URL=
# JSON argv array for the compiled read-only Rust decoder; never a shell command.
ZCASH_TX_INSPECTOR=
# Opt-in developer-custodied testnet recognition. Never enable in production.
ZYRO_CUSTODIAL_DEMO=0
ZCASH_DEMO_WALLET_DB=
ZCASH_DEMO_RECEIVER=
# Optional trusted oracle Ed25519 public key, base64 DER SPKI. Private key stays offline.
ORACLE_PUBLIC_KEY=
