{
  "name": "zyro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "\u003e=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @zyro/api\" \"npm run dev -w @zyro/web\"",
    "build": "npm run build -w @zyro/web",
    "typecheck": "tsc --noEmit -p apps/api \u0026\u0026 npm run typecheck -w @zyro/web",
    "test": "vitest run",
    "lint": "eslint apps packages tests",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:postgres": "tsx --env-file-if-exists=.env scripts/postgres-check.ts",
    "format": "prettier --write apps packages tests scripts docs *.md *.json *.yml .github/workflows/*.yml",
    "chain:probe": "tsx --env-file-if-exists=.env scripts/chain-probe.ts",
    "chain:observe": "tsx --env-file-if-exists=.env scripts/observe-transaction.ts",
    "test:mongo": "tsx --env-file-if-exists=.env scripts/mongo-check.ts",
    "test:product-browser": "tsx --env-file-if-exists=.env scripts/product-browser-check.ts",
    "test:arena-browser": "tsx --env-file-if-exists=.env scripts/round5-browser.ts",
    "test:crypto-live": "tsx --env-file-if-exists=.env scripts/round5-live.ts",
    "test:fast-live": "tsx --env-file-if-exists=.env scripts/round6-live.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.1.0"
  }
}
